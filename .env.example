# Required: PostgreSQL database used by the API and migration tools.
DATABASE_URL=

# API and frontend development ports default to 3000, 5173, and 5174
# respectively. Set PORT only on an individual process when overriding it.
NODE_ENV=development
LOG_LEVEL=info

# Required for live model runs. Supply your own Requesty token; this export
# contains no credentials and grants no authorization to make provider calls.
OPENAI_API_KEY=
# Requesty's OpenAI-compatible router endpoint. The Requesty account must have
# access to every model id listed in artifacts/api-server/src/lib/modelRegistry.ts.
OPENAI_BASE_URL=https://router.requesty.ai/v1

# Protects operator-only maintenance routes. Set a long random value.
OPERATOR_TOKEN=
# Used as a fallback to derive OPERATOR_TOKEN when the explicit token is absent.
SESSION_SECRET=

# Frontend development servers proxy relative /api calls here.
API_PROXY_TARGET=http://localhost:3000
# Main platform dev server proxies /aeo-research/ to the research Vite server.
RESEARCH_PROXY_TARGET=http://localhost:5174